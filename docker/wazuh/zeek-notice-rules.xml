<!--
  Zeek rules cho Wazuh v2. ID: 100100-100199.
  Level: 3=telemetry, 7=bat thuong, 8=suy luan tu log, 10=xac nhan cao.
  Nhom: zeek_telemetry (khong phai canh bao), zeek_detection (canh bao an ninh), zeek_operational (cam bien).
  Tuong quan nhieu buoc do agent dieu tra (LangGraph) xu ly, khong nhoi vao rule.
-->
<group name="zeek,network,">

  <!-- 1. Telemetry -->
  <rule id="100121" level="3">
    <decoded_as>json</decoded_as>
    <location type="pcre2">(?:^|/)zeek/logs/current/[^/]+\.log$</location>
    <description>Ban ghi log Zeek (khong phai canh bao)</description>
    <group>zeek_telemetry,</group>
  </rule>

  <rule id="100120" level="3">
    <if_sid>100121</if_sid>
    <location type="pcre2">/notice\.log$</location>
    <field name="note" type="pcre2">^[A-Za-z0-9_]+::[A-Za-z0-9_:]+$</field>
    <description>Zeek notice can phan loai: $(note) - $(msg)</description>
    <group>zeek_notice,zeek_telemetry,</group>
  </rule>

  <rule id="100124" level="3">
    <if_sid>100120</if_sid>
    <field name="note" type="pcre2">^(?:CaptureLoss|ChecksumOffloading)::</field>
    <description>Zeek tinh trang cam bien: $(note) - $(msg)</description>
    <group>zeek_operational,zeek_telemetry,</group>
  </rule>

  <!-- 2. Quet -->
  <rule id="100122" level="8" ignore="120">
    <if_sid>100120</if_sid>
    <field name="note" type="pcre2">^Scan::(?:Port_Scan|Address_Scan)$</field>
    <description>Zeek phat hien quet: $(note) - $(msg)</description>
    <mitre><id>T1046</id></mitre>
    <group>zeek_detection,zeek_scan,</group>
  </rule>

  <rule id="100140" level="3">
    <if_sid>100121</if_sid>
    <location type="pcre2">/conn\.log$</location>
    <field name="proto">^tcp$</field>
    <field name="conn_state" type="pcre2">^(?:S0|REJ)$</field>
    <description>Zeek ket noi TCP that bai (bang chung tuong quan)</description>
    <group>zeek_telemetry,zeek_failed_connection,</group>
  </rule>

  <rule id="100141" level="8" frequency="12" timeframe="60" ignore="60">
    <if_sid>100140</if_sid>
    <if_matched_sid>100140</if_matched_sid>
    <same_field>id.orig_h</same_field>
    <same_field>id.resp_h</same_field>
    <different_field>id.resp_p</different_field>
    <description>Zeek quet cong doc: $(id.orig_h) -> $(id.resp_h), nhieu cong, trong 60s</description>
    <mitre><id>T1046</id></mitre>
    <group>zeek_detection,zeek_scan,zeek_scan_vertical,</group>
  </rule>

  <rule id="100143" level="8" frequency="12" timeframe="60" ignore="60">
    <if_sid>100140</if_sid>
    <if_matched_sid>100140</if_matched_sid>
    <same_field>id.orig_h</same_field>
    <same_field>id.resp_p</same_field>
    <different_field>id.resp_h</different_field>
    <description>Zeek quet ngang: $(id.orig_h) -> nhieu host, cong $(id.resp_p), trong 60s</description>
    <mitre><id>T1046</id></mitre>
    <group>zeek_detection,zeek_scan,zeek_scan_horizontal,</group>
  </rule>

  <!-- 3. DoS (suy luan tu log, chua xac nhan anh huong) -->
  <rule id="100142" level="8" frequency="100" timeframe="10" ignore="60">
    <if_sid>100140</if_sid>
    <if_matched_sid>100140</if_matched_sid>
    <same_field>id.orig_h</same_field>
    <same_field>id.resp_h</same_field>
    <same_field>id.resp_p</same_field>
    <description>Zeek nghi DoS 1 nguon: $(id.orig_h) -> $(id.resp_h):$(id.resp_p); chua xac nhan anh huong</description>
    <mitre><id>T1498</id></mitre>
    <group>zeek_detection,zeek_dos,zeek_dos_single_source,</group>
  </rule>

  <rule id="100145" level="10" frequency="150" timeframe="10" ignore="60">
    <if_sid>100140</if_sid>
    <if_matched_sid>100140</if_matched_sid>
    <same_field>id.resp_h</same_field>
    <same_field>id.resp_p</same_field>
    <different_field>id.orig_h</different_field>
    <description>Zeek nghi DDoS: nhieu nguon -> $(id.resp_h):$(id.resp_p); chua xac nhan anh huong</description>
    <mitre><id>T1498</id></mitre>
    <group>zeek_detection,zeek_dos,zeek_dos_distributed,</group>
  </rule>

  <!-- Bo dem rieng (zeek script), do truc tiep theo nguong cau hinh -->
  <rule id="100160" level="3">
    <if_sid>100121</if_sid>
    <location type="pcre2">/dos\.log$</location>
    <field name="producer">^soc-ai-dos-v1$</field>
    <description>Zeek tong hop DoS (can phan loai)</description>
    <group>zeek_telemetry,</group>
  </rule>

  <rule id="100161" level="10">
    <if_sid>100160</if_sid>
    <field name="metric">^tcp_new_connections$</field>
    <description>Xac nhan DoS TCP toi $(dst):$(dst_port): $(observed) flow moi/$(window_seconds)s, nguong $(threshold), $(source_count) nguon</description>
    <mitre><id>T1498</id></mitre>
    <group>zeek_detection,zeek_dos,zeek_dos_summary,</group>
  </rule>

  <rule id="100162" level="10">
    <if_sid>100160</if_sid>
    <field name="metric">^http_requests$</field>
    <description>Xac nhan DoS HTTP toi $(dst):$(dst_port): $(observed) request/$(window_seconds)s, nguong $(threshold), $(source_count) nguon</description>
    <mitre><id>T1498</id></mitre>
    <group>zeek_detection,zeek_dos,zeek_dos_summary,</group>
  </rule>

  <rule id="100163" level="10">
    <if_sid>100160</if_sid>
    <field name="metric">^udp_new_flows$</field>
    <description>Xac nhan DoS UDP toi $(dst):$(dst_port): $(observed) flow moi/$(window_seconds)s, nguong $(threshold), $(source_count) nguon; khong phai toc do goi</description>
    <mitre><id>T1498</id></mitre>
    <group>zeek_detection,zeek_dos,zeek_dos_summary,</group>
  </rule>

  <rule id="100164" level="10">
    <if_sid>100160</if_sid>
    <field name="metric">^icmp_new_flows$</field>
    <description>Xac nhan ICMP flood toi $(dst): $(observed) flow moi/$(window_seconds)s, nguong $(threshold), $(source_count) nguon; khong phai toc do goi</description>
    <mitre><id>T1498</id></mitre>
    <group>zeek_detection,zeek_dos,zeek_dos_summary,</group>
  </rule>

  <!-- 4. Tan cong web (ignore chong trung lap) -->
  <rule id="100130" level="8" ignore="120">
    <if_sid>100121</if_sid>
    <location type="pcre2">/http\.log$</location>
    <field name="uri" type="pcre2">(?i)(?:union(?:\s|%20|\+|%09)+(?:all(?:\s|%20|\+|%09)+)?select\b|(?:\b|%20|\+)or(?:\s|%20|\+)+(?:1(?:=|%3d)1|'1'(?:=|%3d)'1'))</field>
    <description>Zeek HTTP nghi SQLi: $(id.orig_h) -> $(id.resp_h), $(method) $(host)$(uri)</description>
    <mitre><id>T1190</id></mitre>
    <group>zeek_detection,web_attack,zeek_http_sqli,</group>
  </rule>

  <rule id="100131" level="8" ignore="120">
    <if_sid>100121</if_sid>
    <location type="pcre2">/http\.log$</location>
    <field name="uri" type="pcre2">(?i)(?:\.\.|%2e%2e|\.%2e|%2e\.)(?:/|%2f|%5c|\\)(?:.*(?:etc(?:/|%2f)passwd|windows(?:/|%2f)|proc(?:/|%2f)self))</field>
    <description>Zeek HTTP nghi path traversal file nhay cam: $(id.orig_h) -> $(id.resp_h), $(host)$(uri)</description>
    <mitre><id>T1190</id></mitre>
    <group>zeek_detection,web_attack,zeek_http_traversal,</group>
  </rule>

  <rule id="100132" level="8" ignore="120">
    <if_sid>100121</if_sid>
    <location type="pcre2">/http\.log$</location>
    <field name="uri" type="pcre2">(?i)(?:;|%3b|%7c|\|)(?:\s|%20|\+)*(?:wget|curl|bash|sh)(?:\s|%20|\+|%09)</field>
    <description>Zeek HTTP nghi chen lenh shell: $(id.orig_h) -> $(id.resp_h), $(host)$(uri)</description>
    <mitre><id>T1190</id></mitre>
    <group>zeek_detection,web_attack,zeek_http_command,</group>
  </rule>

  <rule id="100133" level="8" ignore="120">
    <if_sid>100121</if_sid>
    <location type="pcre2">/http\.log$</location>
    <field name="uri" type="pcre2">(?i)(?:%3c|&lt;)(?:\s|%20)*script\b|javascript:|on(?:error|load|click|mouseover)(?:\s|%20)*=</field>
    <description>Zeek HTTP nghi XSS: $(id.orig_h) -> $(id.resp_h), $(host)$(uri)</description>
    <mitre><id>T1190</id></mitre>
    <group>zeek_detection,web_attack,zeek_http_xss,</group>
  </rule>

  <rule id="100134" level="10" frequency="5" timeframe="300" ignore="300">
    <if_group>web_attack</if_group>
    <if_matched_group>web_attack</if_matched_group>
    <same_field>id.orig_h</same_field>
    <description>Zeek: $(id.orig_h) tan cong web lap lai trong 5 phut, nghi cong cu quet/khai thac tu dong</description>
    <mitre><id>T1190</id></mitre>
    <group>zeek_detection,web_attack,web_attack_campaign,</group>
  </rule>

  <!-- 5. DNS bat thuong -->
  <rule id="100150" level="3">
    <if_sid>100121</if_sid>
    <location type="pcre2">/dns\.log$</location>
    <field name="rcode_name">^NXDOMAIN$</field>
    <description>Zeek DNS NXDOMAIN (bang chung tuong quan)</description>
    <group>zeek_telemetry,zeek_dns_failure,</group>
  </rule>

  <rule id="100151" level="7" frequency="20" timeframe="60" ignore="60">
    <if_sid>100150</if_sid>
    <if_matched_sid>100150</if_matched_sid>
    <same_field>id.orig_h</same_field>
    <description>Zeek DNS loi hang loat tu $(id.orig_h) trong 60s: nghi cau hinh sai hoac DGA</description>
    <group>zeek_detection,zeek_dns_anomaly,</group>
  </rule>

  <!-- Loai query hiem chi la telemetry; su kien label dai uu tien cac rule ben duoi. -->
  <rule id="100183" level="4">
    <if_sid>100121</if_sid>
    <location type="pcre2">/dns\.log$</location>
    <field name="qtype_name" type="pcre2">^(NULL|PRIVATE|KEY)$</field>
    <description>Zeek DNS loai query hiem $(qtype_name) tu $(id.orig_h)</description>
    <group>zeek_telemetry,zeek_dns_anomaly,</group>
  </rule>

  <!-- Cung agent, nguon, dich, cong va loai query; different_field khong dem so ten duy nhat. -->
  <rule id="100181" level="7" frequency="5" timeframe="60" ignore="200">
    <if_matched_sid>100183</if_matched_sid>
    <same_field>id.orig_h</same_field>
    <same_field>id.resp_h</same_field>
    <same_field>id.resp_p</same_field>
    <same_field>qtype_name</same_field>
    <different_field>query</different_field>
    <description>Zeek DNS: nhieu query $(qtype_name) tu $(id.orig_h) toi $(id.resp_h):$(id.resp_p) trong 60s, can xac minh</description>
    <mitre><id>T1071.004</id></mitre>
    <group>zeek_detection,zeek_dns_anomaly,</group>
  </rule>

  <!-- Label DNS dai; dem moi byte Zeek ghi dang \xNN la mot ky tu, giu .local cho lab -->
  <rule id="100152" level="5">
    <if_sid>100121</if_sid>
    <location type="pcre2">/dns\.log$</location>
    <field name="query" type="pcre2">(?i)^(?!.*(?:\.arpa|\.lan|\.akamaiedge\.net|\.cloudfront\.net|\.amazonaws\.com|\.windows\.net|\.msedge\.net|\.googleusercontent\.com)\.?$)(?!.*(?:^|\.)(?:_domainkey|_dmarc|_acme-challenge)(?:\.|$)).*(?:^|\.)(?:[a-z0-9_+=-]|\\x[0-9a-f]{2}){32,}\.</field>
    <description>Zeek DNS label dai (nghi tunneling): $(query)</description>
    <group>zeek_telemetry,zeek_dns_anomaly,</group>
  </rule>

  <rule id="100154" level="7">
    <if_sid>100152</if_sid>
    <field name="qtype_name" type="pcre2">^(TXT|NULL|CNAME|MX)$</field>
    <description>Zeek DNS label dai, loai $(qtype_name) tu $(id.orig_h): $(query)</description>
    <group>zeek_telemetry,zeek_dns_anomaly,</group>
  </rule>

  <rule id="100155" level="7">
    <if_sid>100152</if_sid>
    <field name="query" type="pcre2">(?i)(^|\.)([a-z2-7]{32,}|[a-f0-9]{32,})\.</field>
    <description>Zeek DNS label giong base32/hex tu $(id.orig_h): $(query)</description>
    <group>zeek_telemetry,zeek_dns_anomaly,</group>
  </rule>

  <rule id="100153" level="8" frequency="2" timeframe="120">
    <if_matched_sid>100152</if_matched_sid>
    <same_field>id.orig_h</same_field>
    <different_field>query</different_field>
    <description>Nghi DNS tunneling: $(id.orig_h) gui nhieu query label dai khac nhau trong 120s</description>
    <mitre><id>T1071.004</id></mitre>
    <group>zeek_detection,zeek_dns_tunneling,</group>
  </rule>

  <rule id="100156" level="12" frequency="5" timeframe="120">
    <if_matched_sid>100154</if_matched_sid>
    <same_field>id.orig_h</same_field>
    <different_field>query</different_field>
    <description>Nghi DNS tunneling: $(id.orig_h) gui nhieu query TXT/NULL/CNAME/MX label dai</description>
    <mitre><id>T1071.004</id></mitre>
    <group>zeek_detection,zeek_dns_tunneling,</group>
  </rule>

  <rule id="100157" level="8" frequency="2" timeframe="120">
    <if_matched_sid>100155</if_matched_sid>
    <same_field>id.orig_h</same_field>
    <different_field>query</different_field>
    <description>Nghi DNS tunneling: $(id.orig_h) gui nhieu query label dang ma hoa</description>
    <mitre><id>T1071.004</id></mitre>
    <group>zeek_detection,zeek_dns_tunneling,</group>
  </rule>

  <!-- 6. SSH brute force (bang chung mang, doi chieu auth log host) -->
  <rule id="100170" level="3">
    <if_sid>100121</if_sid>
    <location type="pcre2">/ssh\.log$</location>
    <description>Zeek phien SSH (bang chung tuong quan)</description>
    <group>zeek_telemetry,</group>
  </rule>

  <rule id="100171" level="3">
    <if_sid>100170</if_sid>
    <field name="auth_success">^F$</field>
    <description>Zeek phien SSH khong xac thuc thanh cong</description>
    <group>zeek_telemetry,zeek_ssh_failed,</group>
  </rule>

  <rule id="100172" level="8" frequency="8" timeframe="60" ignore="60">
    <if_sid>100171</if_sid>
    <if_matched_sid>100171</if_matched_sid>
    <same_field>id.orig_h</same_field>
    <same_field>id.resp_h</same_field>
    <description>Zeek nghi brute force SSH: $(id.orig_h) -> $(id.resp_h), nhieu phien that bai trong 60s (doi chieu auth log host)</description>
    <mitre><id>T1110</id></mitre>
    <group>zeek_detection,zeek_bruteforce,zeek_ssh_bruteforce,</group>
  </rule>

  <!-- 7. Intel -->
  <rule id="100123" level="10" ignore="300">
    <if_sid>100120</if_sid>
    <field name="note" type="pcre2">^Intel::Notice$</field>
    <description>Zeek khop intel: $(msg)</description>
    <group>zeek_detection,zeek_intel,</group>
  </rule>

</group>
