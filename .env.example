# Generate secrets with scripts/configure_local.py; never commit .env.
WAZUH_ENABLED=true
WAZUH_WEBHOOK_TOKEN=
# Password used only during Agent enrollment. Use 24+ alphanumeric characters.
WAZUH_ENROLLMENT_PASSWORD=
WAZUH_FORWARDER_TARGET_URL=http://soc-ai-app:8100/wazuh
WAZUH_FORWARD_MIN_LEVEL=3
WAZUH_FORWARD_GROUP_ALLOWLIST=
# Archive collection bypasses alert-level/group filters; AI policy stays separate.
WAZUH_ARCHIVES_ENABLED=true
WAZUH_AI_MIN_LEVEL=7
WAZUH_AI_RULE_ALLOWLIST=
WAZUH_AI_GROUP_ALLOWLIST=syscheck
WAZUH_MAX_PAYLOAD_BYTES=262144
WAZUH_SPOOL_MAX_BYTES=268435456
AI_MAX_CONCURRENCY=1
AI_QUEUE_LIMIT=1000
AI_CONTEXT_CHARS=6000
AI_ALERT_CHARS=5000
# langgraph (default) or legacy; never silently falls back after graph failures.
AI_WORKFLOW=langgraph
AI_GRAPH_MAX_ROUNDS=3
AI_GRAPH_MAX_MODEL_CALLS=4
AI_GRAPH_MAX_TOOL_CALLS=6
AI_GRAPH_TIMEOUT=900
AI_TOOL_TIMEOUT=15
AI_GRAPH_CONTEXT_CHARS=9000
# Optional separate legacy playbook step, after the investigation is durably saved.
AI_PLAYBOOK_ENABLED=false
LANGGRAPH_STRICT_MSGPACK=true
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
AGENT_MODEL=qwen3:8b
OLLAMA_MODEL_ALIAS=qwen3_8b
OLLAMA_TIMEOUT=900
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024
CHROMA_PATH=./rag/chroma_db
CHROMA_COLLECTION_NAME=soc_knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RUNTIME_DB_PATH=./data/soc_runtime.sqlite3
SOC_BIND_HOST=127.0.0.1
SOC_PORT=8100
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://127.0.0.1:8100
